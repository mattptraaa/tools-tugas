{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User identity and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "preferredModel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "AnalysisHistory": {
      "title": "Analysis History",
      "description": "Stored historical analyses for students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "question": { "type": "string" },
        "courseSubject": { "type": "string" },
        "modelUsed": { "type": "string" },
        "result": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "question"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual student profile and custom settings"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "AnalysisHistory",
      "description": "Student analysis and question history"
    }
  }
}
